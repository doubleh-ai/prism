# Coverage configuration — see https://coverage.readthedocs.io
[run]
branch = True
source = server
omit =
    server/__init__.py
    server/services/__init__.py

[report]
exclude_lines =
    pragma: no cover
    raise NotImplementedError
    if __name__ == .__main__.:
    if TYPE_CHECKING:
    \.\.\.
    pass

# Show missing lines for easier gap analysis
show_missing = True
skip_covered = False
precision = 1

[html]
directory = htmlcov

[xml]
output = coverage.xml
