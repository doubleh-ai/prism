# Prism — 环境变量参考模板
# 注意：本文件仅作为配置项说明，Prism 进程不会自动读取磁盘上的 .env 文件。
# 请通过操作系统环境变量、systemd EnvironmentFile 或 Docker -e 注入实际配置，严禁将真实密钥提交至 Git。

# ── 1. 大模型服务商 API Keys（按厂商物理隔离，按需选配 1 家或多家）──
# DeepSeek 官方平台 (https://platform.deepseek.com/api_keys)
DEEPSEEK_API_KEY=

# MiniMax 国内直连 / 国际站 (https://platform.minimaxi.com / https://platform.minimax.io)
MINIMAX_CN_API_KEY=
MINIMAX_API_KEY=

# Kimi Moonshot 开放平台 (https://platform.moonshot.cn)
KIMI_API_KEY=

# 智谱 GLM BigModel 开放平台 (https://open.bigmodel.cn)
GLM_API_KEY=

# Google AI Studio / Gemini 官方 Key（同时可用于随行 Agent 与风向雷达 Google Search 联网溯源）
GEMINI_API_KEY=

# Anthropic Claude 官方平台 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# OpenAI 官方平台（启用时必须同时显式指定账号支持的 OPENAI_MODEL，如 gpt-4.1）
OPENAI_API_KEY=
OPENAI_MODEL=

# 可选：指定全站默认模型槽位（必须已配置对应厂商的 Key）
# PRISM_DEFAULT_MODEL=deepseek-chat

# ── 2. 存储、初始账号与安全边界 ──
# STOCK_DATA_DIR=/absolute/path/to/prism-data
# STOCK_LOG_FILE=/absolute/path/to/prism-data/app.log
# ADMIN_USER=local-admin
# ADMIN_PASS=change-me-strong-password
# PRISM_COOKIE_SECURE=1
# PRISM_ALLOWED_ORIGINS=https://prism.example.com
# RATE_CHAT_PER_MIN=20
# RATE_LOGIN_PER_MIN=10

# ── 3. 可选扩展数据源与研究白名单 ──
# PRISM_TUSHARE_TOKEN=
# PRISM_RESEARCH_SOURCE_HOSTS=
