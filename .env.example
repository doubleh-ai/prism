# Prism — 环境变量模板
# 仅为变量名示例；应用不会自动加载此文件。实际值由私有环境或密钥管理注入，禁止入库。
#
# 获取 API Key:
#   DeepSeek   → https://platform.deepseek.com/api_keys
#   MiniMax    → https://platform.minimax.io/subscribe/token-plan

# ── 模型 API Keys（按平台独立配置）──
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
# 可选的显式 OpenAI 接入；必须同时指定账号支持的具体模型 ID，不继承 LLM_API_KEY。
OPENAI_API_KEY=
OPENAI_MODEL=

# 默认模型（必须已配置对应平台的 Key）
# PRISM_DEFAULT_MODEL=minimax-m3

# ── 可选覆盖 ──
# STOCK_DATA_DIR=/absolute/path/to/prism-data
# RATE_CHAT_PER_MIN=20
# RATE_LOGIN_PER_MIN=10
# STOCK_LOG_FILE=/absolute/path/to/prism.log
# PRISM_RESEARCH_SOURCE_HOSTS=
