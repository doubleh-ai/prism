# Prism — 环境变量模板
# 复制为 .env 并填入实际值（.env 已加入 .gitignore，不会泄露）
#
# 获取 API Key:
#   DeepSeek   → https://platform.deepseek.com/api_keys
#   MiniMax    → https://platform.minimax.io/subscribe/token-plan

# ── 模型 API Keys（按平台独立配置）──
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=

# 默认模型（必须已配置对应平台的 Key）
# PRISM_DEFAULT_MODEL=minimax-m3

# ── 可选覆盖 ──
# STOCK_DATA_DIR=/absolute/path/to/prism-data
# RATE_CHAT_PER_MIN=20
# RATE_LOGIN_PER_MIN=10
# STOCK_LOG_FILE=/absolute/path/to/prism.log
# PRISM_RESEARCH_SOURCE_HOSTS=
